{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/(auth|metrics|services|sim|incidents|audit|export|health)(/.*)?$",
      "dest": "/api/index.py"
    },
    {
      "src": "^/css/(.*)$",
      "dest": "/frontend/css/$1"
    },
    {
      "src": "^/js/(.*)$",
      "dest": "/frontend/js/$1"
    },
    {
      "src": "^/vendor/(.*)$",
      "dest": "/frontend/vendor/$1"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/frontend/assets/$1"
    },
    {
      "src": "^/favicon\\.ico$",
      "dest": "/frontend/favicon.ico"
    },
    {
      "src": "^/_vercel/(.*)$",
      "dest": "/_vercel/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/frontend/index.html"
    }
  ]
}


