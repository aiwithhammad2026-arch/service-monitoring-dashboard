# Service Monitoring Dashboard - Environment Configuration
# Copy this file to .env for local overrides

# Database location (SQLite WAL mode)
MD_DB_PATH=monitoring.db

# Secret key used for signing session cookies with itsdangerous
# WARNING: Change this in any non-development environment!
MD_SECRET_KEY=insecure-dev-secret-key-change-in-production

# Simulator configuration
MD_SIM_SEED=42
MD_SIM_TICK=5.0

# Security settings
MD_SECURE_COOKIES=false

# Monitoring thresholds and windows
MD_STALE_AFTER_S=180
MD_ACTIVE_USER_WINDOW_M=15
